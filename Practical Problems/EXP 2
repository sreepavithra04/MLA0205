          "text": [
            "'trainingdata.csv' not found. Creating a default sample training dataset...\n",
            "\n",
            "Specific Boundary (S):\n",
            "['Sunny', 'Warm', '?', 'Strong', '?', '?']\n",
            "\n",
            "General Boundary (G):\n",
            "['Sunny', '?', '?', '?', '?', '?']\n",
            "['?', 'Warm', '?', '?', '?', '?']\n"
          ]
        }
      ],
      "source": [
        "import csv\n",
        "import os\n",
        "\n",
        "data = []\n",
        "\n",
        "# Check if the file exists; if not, we can write a sample dataset\n",
        "if not os.path.exists(\"trainingdata.csv\"):\n",
        "    print(\"'trainingdata.csv' not found. Creating a default sample training dataset...\\n\")\n",
        "    sample_data = [\n",
        "        [\"Sky\", \"AirTemp\", \"Humidity\", \"Wind\", \"Water\", \"Forecast\", \"EnjoySport\"],\n",
        "        [\"Sunny\", \"Warm\", \"Normal\", \"Strong\", \"Warm\", \"Same\", \"Yes\"],\n",
        "        [\"Sunny\", \"Warm\", \"High\", \"Strong\", \"Warm\", \"Same\", \"Yes\"],\n",
        "        [\"Rainy\", \"Cold\", \"High\", \"Strong\", \"Warm\", \"Change\", \"No\"],\n",
        "        [\"Sunny\", \"Warm\", \"High\", \"Strong\", \"Cool\", \"Change\", \"Yes\"]\n",
        "    ]\n",
        "    with open(\"trainingdata.csv\", \"w\", newline=\"\") as file:\n",
        "        writer = csv.writer(file)\n",
        "        writer.writerows(sample_data)\n",
        "\n",
        "with open(\"trainingdata.csv\", \"r\") as file:\n",
        "    reader = csv.reader(file)\n",
        "    next(reader)\n",
        "    for row in reader:\n",
        "        data.append(row)\n",
        "\n",
        "n = len(data[0]) - 1\n",
        "\n",
        "S = ['0'] * n\n",
        "G = [['?'] * n]\n",
        "\n",
        "for row in data:\n",
        "    x = row[:-1]\n",
        "    label = row[-1].lower()\n",
        "\n",
        "    if label == \"yes\":\n",
        "        # Remove general hypotheses inconsistent with positive example\n",
        "        G = [g for g in G if all(g[i] == '?' or g[i] == x[i]\n",
        "                                  for i in range(n))]\n",
        "\n",
        "        # Generalize S\n",
        "        for i in range(n):\n",
        "            if S[i] == '0':\n",
        "                S[i] = x[i]\n",
        "            elif S[i] != x[i]:\n",
        "                S[i] = '?'\n",
        "\n",
        "        # Remove hypotheses in G that are more specific than S\n",
        "        G = [g for g in G if all(g[i] == '?' or S[i] == '?' or\n",
        "                                  g[i] == S[i] for i in range(n))]\n",
        "\n",
        "    else:\n",
        "        # Specific to general elimination on negative example\n",
        "        new_G = []\n",
        "        for g in G:\n",
        "            if all(g[i] == '?' or g[i] == x[i] for i in range(n)):\n",
        "                # g is consistent with negative example, so we must specialize it\n",
        "                for i in range(n):\n",
        "                    if g[i] == '?':\n",
        "                        for val in [S[i]]:\n",
        "                            if val != '0' and val != '?' and val != x[i]:\n",
        "                                g_spec = list(g)\n",
        "                                g_spec[i] = val\n",
        "                                if g_spec not in new_G:\n",
        "                                    new_G.append(g_spec)\n",
        "            else:\n",
        "                new_G.append(g)\n",
        "        # Keep only hypotheses in G that are consistent with S\n",
        "        G = [g for g in new_G if all(g[i] == '?' or S[i] == '?' or g[i] == S[i] for i in range(n))]\n",
        "\n",
        "print(\"Specific Boundary (S):\")\n",
        "print(S)\n",
        "\n",
        "print(\"\\nGeneral Boundary (G):\")\n",
        "for g in G:\n",
        "    print(g)"
      ]
